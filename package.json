{
  "name": "spotmusic",
  "version": "1.0.11",
  "description": "SpotMusic - Spotify Playlist, Album & Track Downloader with Audio Preview and Licensing",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maverick-Dev01/SpotMusic.git"
  },
  "scripts": {
    "start": "electron .",
    "setup:binaries": "node scripts/setup-binaries.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build": "electron-builder -mw",
    "package": "npm run setup:binaries && electron-builder -mw",
    "test": "node --test tests/*.cjs"
  },
  "build": {
    "appId": "com.spotmusic.app",
    "productName": "SpotMusic",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "bin/mac/",
          "to": "bin/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "bin/win/",
          "to": "bin/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpotMusic"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Spotify login",
        "schemes": [
          "spotmusic-login"
        ]
      }
    ]
  },
  "keywords": [
    "spotify",
    "music",
    "downloader",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  }
}
