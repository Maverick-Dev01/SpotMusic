{
  "name": "spotmusic",
  "version": "1.0.0",
  "description": "SpotMusic - Spotify Playlist, Album & Track Downloader with Audio Preview and Licensing",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maverick-Dev01/SpotMusic.git"
  },
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build": "electron-builder -mw",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.spotmusic.app",
    "productName": "SpotMusic",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "spotify",
    "music",
    "downloader",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.1"
  }
}
